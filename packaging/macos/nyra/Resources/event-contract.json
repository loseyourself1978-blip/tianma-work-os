{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TWOS Nyra status v4 — bounded local task labels",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "producer_instance_id",
    "event_id",
    "sequence",
    "timestamp",
    "session_id",
    "task_id",
    "state",
    "source",
    "simulation"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "twos.nyra.status.v1",
        "twos.nyra.status.v2",
        "twos.nyra.status.v3",
        "twos.nyra.status.v4"
      ]
    },
    "producer_instance_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "session_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "task_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "state": {
      "enum": [
        "idle",
        "queued",
        "running",
        "waiting_user",
        "partial",
        "failed",
        "completed_unverified",
        "verified_success",
        "cancelled",
        "disconnected",
        "activity_unknown"
      ]
    },
    "source": {
      "type": "string",
      "enum": [
        "twos_runtime",
        "codex_adapter",
        "web_handoff_adapter",
        "engineering_simulator"
      ]
    },
    "simulation": {
      "type": "boolean"
    },
    "evidence_ref": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "activity_side": {
      "enum": [
        "left",
        "right",
        "both"
      ]
    },
    "pane_observations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "side",
          "state",
          "reason",
          "fresh"
        ],
        "properties": {
          "side": {
            "enum": [
              "left",
              "right"
            ]
          },
          "state": {
            "enum": [
              "idle",
              "queued",
              "running",
              "waiting_user",
              "partial",
              "failed",
              "completed_unverified",
              "verified_success",
              "cancelled",
              "disconnected",
              "activity_unknown"
            ]
          },
          "reason": {
            "type": "string",
            "pattern": "^[A-Z0-9_]{1,80}$"
          },
          "fresh": {
            "type": "boolean"
          }
        }
      }
    },
    "task_labels": {
      "type": "array",
      "maxItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "side",
          "provider",
          "title"
        ],
        "properties": {
          "side": {
            "enum": [
              "left",
              "right"
            ]
          },
          "provider": {
            "enum": [
              "ChatGPT",
              "Claude",
              "DeepSeek",
              "Codex"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 90
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "verified_success"
          }
        }
      },
      "then": {
        "required": [
          "evidence_ref"
        ],
        "properties": {
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "twos.nyra.status.v2"
          }
        }
      },
      "then": {
        "required": [
          "activity_side"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "twos.nyra.status.v3"
          }
        }
      },
      "then": {
        "required": [
          "activity_side",
          "pane_observations"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "twos.nyra.status.v4"
          }
        }
      },
      "then": {
        "required": [
          "activity_side",
          "pane_observations",
          "task_labels"
        ]
      }
    }
  ]
}
